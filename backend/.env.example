# Leave PORT unset to use 5173 for dev or 4000 for the built store.
# PORT=4000
HOST=127.0.0.1
STORE_DATABASE_DIR=.data/store
# Set to use an existing PostgreSQL database. Keep this credential in backend/.env.
# DATABASE_URL=postgresql://bhagwati_app:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:5432/bhagwati_publication
# Enable secure cookies for HTTPS hosting.
# SECURE_COOKIES=1
# Set only behind one trusted reverse proxy.
# TRUST_PROXY=1
# Optional admin password recovery by email. Keep production values in your hosting dashboard.
# ADMIN_RECOVERY_EMAIL=owner@example.com
# RESEND_API_KEY=
# Contact form emails use RESEND_API_KEY. Without CONTACT_EMAIL, the initial inbox uses ADMIN_RECOVERY_EMAIL.
# CONTACT_EMAIL=
# CONTACT_EMAIL_FROM=
# ADMIN_RECOVERY_FROM=Bhagwati Publication <admin@example.com>
